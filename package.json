{
  "name": "streamlite-webos",
  "version": "1.3.0",
  "description": "Core Rust/Assembly ARM con interfaccia ES5 per LG webOS 3.x e 4.x",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "check": "node scripts/check_es5.js",
    "test": "python tests/e2e_test.py",
    "build": "bash scripts/build.sh",
    "verify": "npm run check && npm run test:rust && npm run build:host && npm run test:service && npm test && npm run test:native && npm run build && python scripts/verify_ipk.py --ui-test",
    "test:rust": "cargo test --locked --manifest-path native/Cargo.toml",
    "build:host": "cargo build --locked --release --manifest-path native/Cargo.toml",
    "build:web": "bash scripts/build.sh --web-only",
    "test:service": "node tests/service_test.js",
    "test:native": "python tests/e2e_test.py --native"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devaxto/Stream4ioLiteForLG.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@webos-tools/cli": "3.2.0",
    "acorn": "8.15.0"
  },
  "private": true
}
